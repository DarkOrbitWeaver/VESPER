{
  "manifest_version": 3,
  "name": "VESPER Download Manager",
  "short_name": "VESPER",
  "version": "1.0.9",
  "version_name": "1.0.9-rc.1",
  "description": "Send downloads and supported media from your browser to the VESPER desktop app. No accounts, no analytics.",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": {
    "16": "icons/vesper-16.png",
    "32": "icons/vesper-32.png",
    "48": "icons/vesper-48.png",
    "128": "icons/vesper-128.png"
  },
  "action": {
    "default_title": "VESPER",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/vesper-16.png",
      "32": "icons/vesper-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "nativeMessaging",
    "contextMenus",
    "storage",
    "downloads",
    "webRequest",
    "alarms"
  ],
  "optional_permissions": [
    "cookies"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["browser-preferences.js", "early-download.js", "early-download-click.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["media-source-witness.js", "generated-download-witness.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["https://*.youtube.com/*"],
      "js": ["youtube-player-witness.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "theme.js",
        "player-source.js",
        "vesper-companion.js",
        "vesper-intelligence.js",
        "vesper-model.js",
        "vesper-inference.js",
        "vesper-control-evidence.js",
        "browser-body.js",
        "content.js",
        "vesper-smart-batch.js",
        "smart-select.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/vesper-companion-atlas.png",
        "icons/vesper-32.png"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
