{
  "manifest_version": 3,
  "name": "VESPER Download Manager",
  "short_name": "VESPER",
  "version": "1.0.0",
  "description": "Send downloads and supported media from your browser to the VESPER desktop app. No accounts, no analytics.",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": { "16": "icons/vesper-16.png", "32": "icons/vesper-32.png", "48": "icons/vesper-48.png", "128": "icons/vesper-128.png" },
  "action": {
    "default_title": "VESPER",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/vesper-16.png", "32": "icons/vesper-32.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["nativeMessaging", "contextMenus", "storage", "downloads", "webRequest"],
  "optional_permissions": ["cookies"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["theme.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    { "resources": ["icons/butterfly-perched.png", "icons/butterfly-front.png"], "matches": ["http://*/*", "https://*/*"] }
  ]
}
