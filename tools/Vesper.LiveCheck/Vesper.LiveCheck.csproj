<Project Sdk="Microsoft.NET.Sdk">
  <!-- Development tool: on-demand live compatibility runner. Not part of the shipped application. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Avoid System.Net.Http.StreamContent shadowing the resolver model type in the linked bridge file. -->
    <Using Remove="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Vesper.Engine\Vesper.Engine.csproj" />
    <ProjectReference Include="..\..\src\Vesper.MediaResolver\Vesper.MediaResolver.csproj" />
    <!-- The exact selection/plan code the desktop app and browser bridge use. -->
    <Compile Include="..\..\MediaTransferBridge.cs" Link="MediaTransferBridge.cs" />
  </ItemGroup>
</Project>
