<Project>

  <!-- One version for the app, the native host, the setup and the extension manifest (scripts/Build-Release.ps1
       passes -p:Version). The short commit is stamped into InformationalVersion so a running build can be told
       apart from the repository: "1.0.2+2620e76". Local builds that have no commit say "+local". -->
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">1.0.4-preview.1</Version>
    <SourceRevisionId Condition="'$(SourceRevisionId)' == ''">local</SourceRevisionId>
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

</Project>
