<Project>

  <!-- Shared desktop, host and setup version. Packaging checks the extension version and stamps the source revision. -->
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">1.0.13-rc.1</Version>
    <SourceRevisionId Condition="'$(SourceRevisionId)' == ''">local</SourceRevisionId>
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

</Project>
