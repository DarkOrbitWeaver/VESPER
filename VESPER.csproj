<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseAppHost>true</UseAppHost>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\VESPER-Illustrated.ico</ApplicationIcon>
    <AssemblyName>VESPER</AssemblyName>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Product>VESPER</Product>
    <Company>VESPER</Company>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ForceDesignerDpiUnaware>true</ForceDesignerDpiUnaware>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <!-- The engine, native host, tests and extension live in subfolders and have their own projects. -->
  <ItemGroup>
    <Compile Remove="src\**;tests\**;extension\**;scripts\**;release\**;tools\**" />
    <EmbeddedResource Remove="src\**;tests\**;extension\**;scripts\**;release\**;tools\**" />
    <None Remove="src\**;tests\**;extension\**;scripts\**;release\**;tools\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vesper.Windows.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\VESPER-Illustrated.ico;Assets\Botanical\butterfly.png;Assets\Botanical\empty-hero.png;Assets\Botanical\header.png;Assets\Botanical\sprig.png;Assets\Botanical\hills-left.png;Assets\Botanical\hills.png" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="src\Vesper.Engine\Vesper.Engine.csproj" />
    <ProjectReference Include="src\Vesper.MediaResolver\Vesper.MediaResolver.csproj" />
    <ProjectReference Include="src\Vesper.NativeHost\Vesper.NativeHost.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyDevelopmentBrowserHelper" AfterTargets="Build"
          Condition="'$(OS)' == 'Windows_NT' and '$(RuntimeIdentifier)' == '' and '$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <DevelopmentHelper Include="src\Vesper.NativeHost\bin\$(Configuration)\net10.0\vesper-host.exe;src\Vesper.NativeHost\bin\$(Configuration)\net10.0\vesper-host.dll;src\Vesper.NativeHost\bin\$(Configuration)\net10.0\vesper-host.deps.json;src\Vesper.NativeHost\bin\$(Configuration)\net10.0\vesper-host.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(DevelopmentHelper)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
