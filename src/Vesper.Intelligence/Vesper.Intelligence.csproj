<Project Sdk="Microsoft.NET.Sdk">

  <!-- Portable VESPER Intelligence: no WinForms, engine or third-party dependencies. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Vesper.Intelligence</RootNamespace>
    <AssemblyName>Vesper.Intelligence</AssemblyName>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The same validated artifacts the extension ships (generated by scripts/train-intelligence.mjs promote). -->
    <EmbeddedResource Include="..\..\intelligence\models\active\*.json" LogicalName="Vesper.Intelligence.Models.%(Filename).json" />
    <EmbeddedResource Include="..\..\intelligence\models\baseline\player-intent@2.0.0-baseline.json" LogicalName="Vesper.Intelligence.Fallback.player-intent.json" />
    <EmbeddedResource Include="..\..\intelligence\models\baseline\source-association@1.0.0-baseline.json" LogicalName="Vesper.Intelligence.Fallback.source-association.json" />
    <InternalsVisibleTo Include="Vesper.Intelligence.Tests" />
  </ItemGroup>

</Project>
