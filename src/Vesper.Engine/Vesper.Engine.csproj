<Project Sdk="Microsoft.NET.Sdk">

  <!-- The engine has no WinForms dependency so it can be tested headlessly. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Vesper.Engine</RootNamespace>
    <AssemblyName>Vesper.Engine</AssemblyName>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\NetworkConnector.cs" Link="Http\NetworkConnector.cs" />
    <Compile Include="..\Shared\OriginAwareProxy.cs" Link="Http\OriginAwareProxy.cs" />
    <Compile Include="..\Shared\NetworkAddressPolicy.cs" Link="Http\NetworkAddressPolicy.cs" />
    <Compile Include="..\Shared\FileNameRules.cs" Link="Files\FileNameRules.cs" />
    <Compile Include="..\Shared\Mp4TopLevelExtent.cs" Link="Media\Mp4TopLevelExtent.cs" />
    <Compile Include="..\Shared\WindowsObjectNames.cs" Link="WindowsObjectNames.cs" />
    <Compile Include="..\Shared\SetupExitProtocol.cs" Link="SetupExitProtocol.cs" />
    <!-- The only third-party dependency: SQLite (MIT) for transactional job state. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vesper.Tests" />
    <InternalsVisibleTo Include="Vesper.Windows.Tests" />
    <InternalsVisibleTo Include="Vesper.MediaResolver.Benchmarks" />
    <InternalsVisibleTo Include="Vesper.LiveCheck" />
  </ItemGroup>

</Project>
