<Project Sdk="Microsoft.NET.Sdk">

  <!-- The engine has no WinForms dependency so it can be tested headlessly. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Vesper.Engine</RootNamespace>
    <AssemblyName>Vesper.Engine</AssemblyName>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- The only third-party dependency: SQLite (MIT) for transactional job state. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vesper.Tests" />
    <InternalsVisibleTo Include="Vesper.MediaResolver.Benchmarks" />
    <InternalsVisibleTo Include="Vesper.LiveCheck" />
  </ItemGroup>

</Project>
